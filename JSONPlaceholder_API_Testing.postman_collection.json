{
  "info": {
    "_postman_id": "b7e1a2f0-4d3c-4e5a-9f21-a1c3d5e7f901",
    "name": "JSONPlaceholder API Testing - 10Pearls Assignment 4",
    "description": "API testing collection for JSONPlaceholder (https://jsonplaceholder.typicode.com) covering GET, POST, PUT, and DELETE requests with automated Postman tests for status codes, response time, response structure, and field validation.\n\nPrepared by: Sameer Hassan\nInternship: QA (Manual + Automation) - 10Pearls Shine Internship Program\nAssignment: Assignment 4 - API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET Requests",
      "item": [
        {
          "name": "Get All Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts",
              "host": ["{{base_url}}"],
              "path": ["posts"]
            },
            "description": "Retrieves the full list of posts from JSONPlaceholder."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Status code validation",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2. Response time validation",
                  "pm.test(\"Response time is less than 1200ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1200);",
                  "});",
                  "",
                  "// 3. Response structure validation",
                  "pm.test(\"Response is an array\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Response contains 100 posts\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.eql(100);",
                  "});",
                  "",
                  "// 4. Field and value validation",
                  "pm.test(\"Each post has required fields (id, title, body, userId)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).to.have.property('id');",
                  "    pm.expect(jsonData[0]).to.have.property('title');",
                  "    pm.expect(jsonData[0]).to.have.property('body');",
                  "    pm.expect(jsonData[0]).to.have.property('userId');",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Single Post (ID 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/1",
              "host": ["{{base_url}}"],
              "path": ["posts", "1"]
            },
            "description": "Retrieves a single post with id = 1 and validates its fields."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Status code validation",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2. Response time validation",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "// 3. Response structure validation",
                  "pm.test(\"Response has exactly the expected keys\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('userId', 'id', 'title', 'body');",
                  "});",
                  "",
                  "// 4. Field and value validation",
                  "pm.test(\"Post id equals 1\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Title is a non-empty string\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.be.a('string').and.to.have.lengthOf.above(0);",
                  "});",
                  "",
                  "pm.test(\"Body is a non-empty string\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.body).to.be.a('string').and.to.have.lengthOf.above(0);",
                  "});",
                  "",
                  "pm.test(\"userId is a number\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.userId).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. POST Requests",
      "item": [
        {
          "name": "Create New Post",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"title\": \"Software Quality Engineering - API Testing\",\n    \"body\": \"This post was created as part of a POST request test for the 10Pearls QA internship assignment.\",\n    \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": ["{{base_url}}"],
              "path": ["posts"]
            },
            "description": "Creates a new post and validates the created resource in the response."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Status code validation",
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "// 2. Response time validation",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "// 3. Response structure validation",
                  "pm.test(\"Response has all expected keys\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('title', 'body', 'userId', 'id');",
                  "});",
                  "",
                  "// 4. Field and value validation",
                  "pm.test(\"Response contains a newly generated id\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test(\"Title matches the request payload\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql(\"Software Quality Engineering - API Testing\");",
                  "});",
                  "",
                  "pm.test(\"userId matches the request payload\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.userId).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. PUT Requests",
      "item": [
        {
          "name": "Update Existing Post (ID 1)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id\": 1,\n    \"title\": \"Updated Post Title - QA Internship\",\n    \"body\": \"This is the updated body content submitted through a PUT request during API testing.\",\n    \"userId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/posts/1",
              "host": ["{{base_url}}"],
              "path": ["posts", "1"]
            },
            "description": "Updates post with id = 1 and validates the updated fields."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Status code validation",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "// 2. Response time validation",
                  "pm.test(\"Response time is less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});",
                  "",
                  "// 3. Response structure validation",
                  "pm.test(\"Response has all expected keys\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('id', 'title', 'body', 'userId');",
                  "});",
                  "",
                  "// 4. Field and value validation",
                  "pm.test(\"Post id remains unchanged (1)\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.id).to.eql(1);",
                  "});",
                  "",
                  "pm.test(\"Title is updated correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.title).to.eql(\"Updated Post Title - QA Internship\");",
                  "});",
                  "",
                  "pm.test(\"Body is updated correctly\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.body).to.eql(\"This is the updated body content submitted through a PUT request during API testing.\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
